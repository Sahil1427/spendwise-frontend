import { Component, computed, inject, signal } from '@angular/core';
import { FormsModule } from '@angular/forms';
import {
  Transaction,
  TransactionService,
} from '../../../services/transaction.service';
import { SettingsService } from '../../../services/settings.service';

type ReportType = 'all' | 'income' | 'expense';

@Component({
  imports: [FormsModule],
  selector: 'app-analytics',
  styleUrl: './analytics.scss',
  templateUrl: './analytics.html',
})
export class Analytics {
  private readonly transactionService = inject(TransactionService);
  private readonly settingsService = inject(SettingsService);

  private readonly now = new Date();

  readonly reportYears = [
    String(this.now.getFullYear()),
    String(this.now.getFullYear() - 1),
  ];

  selectedYear = signal(String(this.now.getFullYear()));

  selectedType = signal<ReportType>('all');

  onTypeChange(type: ReportType): void {
    this.selectedType.set(type);
  }

  nowYear(): string {
    return String(this.now.getFullYear());
  }

  previousYear(): string {
    return String(this.now.getFullYear() - 1);
  }

  readonly monthNames = [
    'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
    'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec',
  ];

  readonly reportTransactions = computed<Transaction[]>(() => {
    const year = this.selectedYear();
    const type = this.selectedType();

    return this.transactionService
      .transactions()
      .filter(item =>
        item.date.startsWith(year) &&
        (type === 'all' || item.type === type)
      );
  });

  incomeTotal = computed(() =>
    this.reportTransactions()
      .filter(item => item.type === 'income')
      .reduce((sum, item) => sum + item.amount, 0)
  );

  expenseTotal = computed(() =>
    this.reportTransactions()
      .filter(item => item.type === 'expense')
      .reduce((sum, item) => sum + item.amount, 0)
  );

  netTotal = computed(
    () => this.incomeTotal() - this.expenseTotal()
  );

  monthlyData = computed(() => {
    const items = this.reportTransactions();
    const year = this.selectedYear();

    const months = Array.from({ length: 12 }, (_, index) => {
      const prefix = `${year}-${String(index + 1).padStart(2, '0')}`;
      const inMonth = items.filter(item => item.date.startsWith(prefix));

      return {
        label: this.monthNames[index],
        income: inMonth
          .filter(item => item.type === 'income')
          .reduce((sum, item) => sum + item.amount, 0),
        expense: inMonth
          .filter(item => item.type === 'expense')
          .reduce((sum, item) => sum + item.amount, 0),
      };
    });

    const max = Math.max(
      1,
      ...months.flatMap(item => [item.income, item.expense])
    );

    return months.map(item => ({
      ...item,
      incomeHeight: (item.income / max) * 100,
      expenseHeight: (item.expense / max) * 100,
    }));
  });

  categoryBreakdown = computed(() => {
    const totals = new Map<string, number>();

    this.reportTransactions()
      .filter(item => item.type === 'expense')
      .forEach(item =>
        totals.set(item.category, (totals.get(item.category) || 0) + item.amount)
      );

    const colors = [
      'var(--accent)',
      '#48b9a1',
      '#f2a65a',
      '#5b9bea',
      '#df83b5',
      '#8b9aa8',
      '#53cba0',
      '#a396ff',
    ];

    const entries = Array.from(totals.entries())
      .map(([name, amount]) => ({ name, amount }))
      .sort((a, b) => b.amount - a.amount)
      .slice(0, 8);

    const max = Math.max(1, ...entries.map(item => item.amount));

    return entries.map((item, index) => ({
      name: item.name,
      amount: this.money(item.amount, this.activeCurrency()),
      percentage: Math.round((item.amount / max) * 100),
      color: colors[index % colors.length],
    }));
  });

  readonly activeCurrency = this.settingsService.currency;

  readonly yearlyComparison = computed(() => {
    const all = this.transactionService.transactions();
    const yearTotals = (year: string) => {
      const inYear = all.filter(item => item.date.startsWith(year));

      return {
        income: inYear
          .filter(item => item.type === 'income')
          .reduce((sum, item) => sum + item.amount, 0),
        expense: inYear
          .filter(item => item.type === 'expense')
          .reduce((sum, item) => sum + item.amount, 0),
      };
    };

    const current = yearTotals(String(this.now.getFullYear()));
    const previous = yearTotals(String(this.now.getFullYear() - 1));

    const delta = (value: number, base: number): string => {
      if (base <= 0) return value > 0 ? 'New' : '—';

      const percent = ((value - base) / base) * 100;
      return `${percent >= 0 ? '+' : ''}${percent.toFixed(1)}%`;
    };

    return [
      {
        label: 'Income',
        current: current.income,
        previous: previous.income,
        change: delta(current.income, previous.income),
      },
      {
        label: 'Expenses',
        current: current.expense,
        previous: previous.expense,
        change: delta(current.expense, previous.expense),
      },
      {
        label: 'Net',
        current: current.income - current.expense,
        previous: previous.income - previous.expense,
        change: '',
      },
    ];
  });

  money(amount: number, currency?: string): string {
    return this.settingsService.formatAmount(amount, currency);
  }
}
